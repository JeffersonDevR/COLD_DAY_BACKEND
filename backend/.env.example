# COLD DAY — Backend .env local (NO commitear, ya está en .gitignore).
# Copia este archivo como `.env` en la carpeta backend/ y pega tus claves.
# Spring Boot lo carga automáticamente vía
# `spring.config.import=optional:file:.env[.properties]` (ver application.properties).
# Formato properties: CLAVE=valor, sin comillas, sin `export`, sin espacios alrededor del `=`.

# Secreto JWT local (mínimo 32 bytes). En prod es obligatorio vía variable de entorno.
JWT_SECRET=cold-day-dev-secret-key-change-me-32-bytes !!

# Google Maps Platform — Server key (restringida por IP en Google Cloud Console).
# APIs a habilitar: Geocoding API, Places API (New), Distance Matrix API, Routes API.
# Consíguela en: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=PEGA_AQUI_TU_SERVER_KEY

# Opcional: si es false, /api/maps/* responde 503 sin llamar a Google (útil para tests sin cuota).
GOOGLE_MAPS_ENABLED=true
