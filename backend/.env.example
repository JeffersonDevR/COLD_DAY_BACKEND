# COLD DAY — Backend .env local (NO commitear, ya está en .gitignore).
# Copia este archivo como `.env` en la carpeta backend/ y pega tus claves.
# Spring Boot lo carga automáticamente vía
# `spring.config.import=optional:file:.env[.properties]` (ver application.properties).
# Formato properties: CLAVE=valor, sin comillas, sin `export`, sin espacios alrededor del `=`.

# Secreto JWT local (mínimo 32 bytes). En prod es obligatorio vía variable de entorno.
JWT_SECRET=cold-day-dev-secret-key-change-me-32-bytes !!

# Google Maps Platform — Server key (restringida por IP en Google Cloud Console).
# APIs a habilitar: Geocoding API, Places API (New), Distance Matrix API, Routes API.
# Consíguela en: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=PEGA_AQUI_TU_SERVER_KEY

# Opcional: si es false, /api/maps/* responde 503 sin llamar a Google (útil para tests sin cuota).
GOOGLE_MAPS_ENABLED=true

# CORS — orígenes del frontend permitidos, separados por coma, sin "/" final
# (coincidencia exacta de esquema + host + puerto). En local basta el dev server
# de Angular; en prod es OBLIGATORIA (sin ella el arranque falla).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Datos de demostración (DevDataSeeder). En local está activo por defecto; en
# prod está apagado salvo que pongas APP_SEED_ENABLED=true (cambia también la password).
# APP_SEED_ENABLED=true
# APP_SEED_DEMO_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# PRODUCCIÓN (Render) — normalmente se definen en el panel de Render, no aquí.
# Se dejan comentadas para no alterar el arranque local. Descoméntalas solo
# para probar el perfil prod contra un Postgres local:
#   .\gradlew bootRun --args="--spring.profiles.active=prod"
# ---------------------------------------------------------------------------
# Perfil activo (endurece la configuración; exige las variables de abajo).
# SPRING_PROFILES_ACTIVE=prod

# PostgreSQL/PostGIS — en local tienen por defecto el contenedor coldday-postgis
# (localhost:5433, cold_day/cold_day); obligatorias en prod, sin valor por defecto.
# La URL debe ir en formato JDBC (jdbc:postgresql://...), no postgres://.
# Contenedor local "coldday-postgis": jdbc:postgresql://localhost:5433/cold_day
# POSTGRES_URL=jdbc:postgresql://localhost:5433/cold_day
# POSTGRES_USER=cold_day
# POSTGRES_PASSWORD=cambia-esto

# Opcionales en prod
# DB_POOL_MAX=10
# LOG_LEVEL=INFO
