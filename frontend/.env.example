# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_ORIGIN: origen del backend. SOLO el host, sin path y SIN '/api'.
# El prefijo '/api' y la version de la API viven en el codigo
# (src/app/core/service/api.config.ts), no en esta variable. Un valor con path
# o con '/api' hace fallar el build a proposito (scripts/generate-api-origin.mjs
# valida y corta el proceso).
# La consume scripts/generate-api-origin.mjs en build para generar
# src/app/core/environment/api-origin.ts.
# En produccion (Vercel) definir el host absoluto, ej:
#   API_ORIGIN=https://cold-day-backend.onrender.com
# Si se deja vacio es el default de desarrollo: url('/x') queda relativo
# ('/api/x') y `ng serve` lo resuelve via proxy.conf.json contra backendUrl.
API_ORIGIN=

# MOBILE_API_ORIGIN: origen ABSOLUTO del backend para la app móvil (el WebView no
# tiene proxy). Lo consume scripts/generate-mobile-origin.mjs en build.
# Sin esto, `npm run mobile:build` compila una app que no llega al backend (el
# arranque lo muestra en pantalla en vez de fallar en silencio).
# Ejemplo: MOBILE_API_ORIGIN=https://colddaybackend-production.up.railway.app
MOBILE_API_ORIGIN=

# GOOGLE_MAPS_BROWSER_API_KEY: Browser key de Google Maps Platform (restringida
# por HTTP referrer). La consume scripts/generate-maps-key.mjs en build para
# generar src/app/core/environment/maps-key.ts. NO se versiona.
# Debe ser DISTINTA de la server key del backend: esta viaja al bundle publico.
# Si no se define, el build usa GOOGLE_MAPS_API_KEY como fallback y avisa.
GOOGLE_MAPS_BROWSER_API_KEY=

# GOOGLE_MAPS_API_KEY: fallback historico del build del frontend. Se mantiene para
# no romper builds locales, pero en produccion la key del navegador debe venir de
# GOOGLE_MAPS_BROWSER_API_KEY (ver arriba).
GOOGLE_MAPS_API_KEY=

# SONAR_TOKEN: token de analisis generado en SonarQube (My Account -> Security).
# Lo consume scripts/sonar.mjs al ejecutar `npm run sonar`. NO se versiona.
SONAR_TOKEN=
