# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_BASE_URL: ruta base de la API del backend.
# La consume scripts/generate-api-url.mjs en build para generar
# src/app/core/environment/api-base-url.ts. Si no se define, queda '/api'
# (default de desarrollo, resuelto por proxy.conf.json contra backendUrl).
# En produccion (Vercel) definir la URL absoluta, ej:
#   API_BASE_URL=https://cold-day-backend.onrender.com/api
API_BASE_URL=

# GOOGLE_MAPS_API_KEY: Browser key de Google Maps Platform (restringida por HTTP referrer).
# La consume scripts/generate-maps-key.mjs en build para generar src/app/core/environment/maps-key.ts.
# Copia este archivo como `.env` y pega tu clave. NO se versiona.
GOOGLE_MAPS_API_KEY=

# SONAR_TOKEN: token de analisis generado en SonarQube (My Account -> Security).
# Lo consume scripts/sonar.mjs al ejecutar `npm run sonar`. NO se versiona.
SONAR_TOKEN=
