<ion-header class="ion-no-border">
  <ion-toolbar>
    <ion-buttons slot="start">
      <ion-back-button defaultHref="/panel"></ion-back-button>
    </ion-buttons>
    <ion-title>
      <div class="header-profile-info">
        <span class="cd-modo__nombre">{{ usuarioNombre() }}</span>
        <span class="cd-modo__pill">{{ esCliente() ? 'Perfil Cliente' : 'Completar Perfil' }}</span>
      </div>
    </ion-title>
  </ion-toolbar>
</ion-header>

<ion-content class="ion-padding">
  <div class="space-y-6 max-w-3xl mx-auto ion-safe-area">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-slate-100">{{ esCliente() ? 'Mi Perfil de Cliente' : 'Completar mi perfil' }}</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        {{ esCliente() ? 'Gestioná tu información y documentos.' : 'Sumá un segundo rol a tu cuenta.' }}
      </p>
    </div>

    @if (errorPerfilExistente()) {
      <div role="alert" class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8 space-y-3">
        <p class="text-sm font-semibold text-amber-900">{{ errorPerfilExistente() }}</p>
        <button type="button" (click)="irAIniciarSesion()" class="inline-flex items-center gap-2 rounded-xl bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
          <i class="pi pi-sign-in"></i> Iniciar sesión
        </button>
      </div>
    }

    @if (sesionActualizada()) {
      <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6 sm:p-8 space-y-3">
        <h2 class="text-lg font-black text-emerald-900 inline-flex items-center gap-2">
          <i class="pi pi-check-circle"></i> Perfil creado
        </h2>
        <p class="text-sm text-emerald-800">Tu sesión se actualizará. Volvé a iniciar sesión para usar tu nuevo perfil.</p>
        <button type="button" (click)="irAIniciarSesion()" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-500">
          <i class="pi pi-sign-out"></i> Iniciar sesión de nuevo
        </button>
      </div>
    } @else {
      @if (!puedeSerTecnico() && !puedeSerCliente()) {
        <div class="rounded-3xl border border-slate-200 bg-white p-6 text-sm text-slate-600 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-300">
          Ya tenés los perfiles de cliente y técnico en tu cuenta.
        </div>
      }

      @if (puedeSerTecnico()) {
        <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:bg-slate-900 dark:border-slate-800 space-y-4">
          <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">Quiero ser técnico</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Ofrecé tus servicios en el radar. Tu perfil queda PENDIENTE hasta validar tus documentos.</p>
          @if (seleccion() !== 'TECNICO') {
            <button type="button" (click)="elegir('TECNICO')" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-500">
              <i class="pi pi-wrench"></i> Quiero ser técnico
            </button>
          }
        </section>
      }
    }
  </div>
</ion-content>