/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/mobile/spec",
    // `google.maps` es necesario desde que A5 importa `MapsApi` (y con él el
    // geocoder del navegador): sin los tipos, el namespace `google` no existe
    // en el programa de specs.
    "types": ["vitest/globals", "google.maps"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
